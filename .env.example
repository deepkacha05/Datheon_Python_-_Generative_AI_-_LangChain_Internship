# ========================================================
# Datheon Internship - Environment Variables Configuration
# ========================================================

# Google Gemini API Configuration (Task 1, 2, 3, 4)
# Get your free key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# OpenAI API Configuration (Optional alternative provider)
# Get your key from https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Default Provider Settings
# Supported options: "gemini" or "openai"
DEFAULT_LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_MODEL=gpt-4o-mini

# Task 2: Vector Embedding Models
# Supported Gemini: "gemini-embedding-001", "gemini-embedding-2"
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Supported OpenAI: "text-embedding-3-small", "text-embedding-ada-002"
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Tavily Search API Key (Used in Task 3 AI Agent for web search)
# Get a free key from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here
